<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Lifecycle of the run. Queued: created, batch job not started. Running: the batch job has parsed the file and is processing slices. Completed: every row processed, none errored. Completed with Errors: some rows errored, or part of the job failed (see Failure Message). Failed: a problem with the whole file, every slice failed, or the job ended without finishing the run. Cancelled: stopped by a user. Queued and Running are 'active': they block a new run on the same roster.</description>
    <label>Status</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Queued</fullName>
                <default>true</default>
                <label>Queued</label>
            </value>
            <value>
                <fullName>Running</fullName>
                <default>false</default>
                <label>Running</label>
            </value>
            <value>
                <fullName>Completed</fullName>
                <default>false</default>
                <label>Completed</label>
            </value>
            <value>
                <fullName>Completed with Errors</fullName>
                <default>false</default>
                <label>Completed with Errors</label>
            </value>
            <value>
                <fullName>Failed</fullName>
                <default>false</default>
                <label>Failed</label>
            </value>
            <value>
                <fullName>Cancelled</fullName>
                <default>false</default>
                <label>Cancelled</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
